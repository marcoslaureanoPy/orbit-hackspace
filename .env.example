# OpenAI-compatible chat endpoint. For a local OpenClaw gateway:
#   1) Enable the loopback Chat Completions API (do not expose the gateway port):
#        openclaw config set gateway.http.endpoints.chatCompletions.enabled true --strict-json
#        openclaw gateway restart   # only if /v1/chat/completions still 404s
#   2) AGENT_API_KEY = your gateway token  (openclaw config get gateway.auth.token)
AGENT_BASE_URL=http://127.0.0.1:18789/v1
AGENT_API_KEY=YOUR_AGENT_TOKEN
AGENT_MODEL=openclaw/default

# Optional stable session id prefix sent as OpenAI "user" field (OpenClaw conv:)
AGENT_SESSION=orbit

# Required if this UI is on a public URL. Locks /orbit/app and live API routes.
# Leave empty for local-only use. Never commit the real value.
ORBIT_ACCESS_PASSWORD=YOUR_ACCESS_PASSWORD
ORBIT_SESSION_SECRET=YOUR_SESSION_SECRET

# Public URL (optional, used in docs / cookies)
# ORBIT_PUBLIC_URL=https://your-domain.example
